# Postgres (Railway fournit ça automatiquement si tu ajoutes le plugin Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET="genere-une-longue-chaine-aleatoire"
NEXTAUTH_URL="https://ton-app.up.railway.app"

# WaveSpeed
WAVESPEED_API_KEY="ta-cle-wavespeed"
WAVESPEED_API_URL="https://api.wavespeed.ai/api/v3"

# Stockage fichiers (Cloudflare R2 - compatible S3)
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_BUCKET="studio-assets"
S3_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"

# Compte admin créé au premier lancement (via script seed)
SEED_ADMIN_EMAIL="toi@exemple.com"
SEED_ADMIN_PASSWORD="change-moi"
SEED_ADMIN_NAME="Yoyo"
